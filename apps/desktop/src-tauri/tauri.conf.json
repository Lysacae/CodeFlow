{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeFlow",
  "version": "1.4.0",
  "identifier": "com.codeflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeFlow",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 3840,
        "maxHeight": 2160,
        "resizable": true,
        "maximizable": true,
        "visible": true,
        "decorations": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "backgroundColor": "#05060b",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
